# Liquid Lore — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit real keys.
#
#     cp .env.example .env.local
#
# The app runs WITHOUT any of these set: the data layer falls back to the local recipe
# seed (data/cocktails.seed.json) and the cabinet persists to localStorage. Accounts,
# the Lounge, and cross-device sync require Supabase.

# ── Supabase (public — safe to expose to the browser) ────────────────────────────
# Project Settings → API → Project URL / anon public key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (server only — NEVER prefix with NEXT_PUBLIC_) ──────────────────────
# Service role key. Bypasses Row Level Security, so it is used only by the seeding
# script in scripts/. If this ever reaches the browser, every user's data is exposed.
SUPABASE_SERVICE_ROLE_KEY=

# ── Library build (optional) ─────────────────────────────────────────────────────
# TheCocktailDB test key "1" is rate-limited but sufficient to build the library.
# A paid key raises the limit for scripts/build-library.mjs.
COCKTAILDB_API_KEY=1
